@page "/events/{Id:int}/register"
@inject EventService EventService
@inject NavigationManager Nav

<PageTitle>Register · EventEase</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="events">Events</a></li>
        @if (ev is not null)
        {
            <li class="breadcrumb-item"><a href="@($"events/{ev.Id}")">@ev.Name</a></li>
        }
        <li class="breadcrumb-item active" aria-current="page">Register</li>
    </ol>
</nav>

@if (ev is null)
{
    <div class="alert alert-warning">No event with ID @Id exists.</div>
    <a class="btn btn-secondary" href="events">Back to events</a>
}
else if (submitted)
{
    <div class="alert alert-success">
        Thanks, <strong>@fullName</strong>! You're registered for <strong>@ev.Name</strong> on @ev.Date.ToString("D").
    </div>
    <button class="btn btn-primary" @onclick="@(() => Nav.NavigateTo("events"))">Browse more events</button>
}
else
{
    <h1>Register for @ev.Name</h1>
    <p class="text-muted">@ev.Date.ToString("D") · @ev.Location</p>

    @* Basic form for now — validation and state management come in Activity 3. *@
    <div class="col-md-6">
        <div class="mb-3">
            <label class="form-label" for="fullName">Full name</label>
            <input id="fullName" class="form-control" @bind="fullName" @bind:event="oninput" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="email">Email</label>
            <input id="email" type="email" class="form-control" @bind="email" @bind:event="oninput" />
        </div>
        <button class="btn btn-success" @onclick="Submit"
                disabled="@(string.IsNullOrWhiteSpace(fullName) || string.IsNullOrWhiteSpace(email))">
            Register
        </button>
        <a class="btn btn-link" href="@($"events/{ev.Id}")">Cancel</a>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private EventItem? ev;
    private string fullName = string.Empty;
    private string email = string.Empty;
    private bool submitted;

    protected override void OnParametersSet()
    {
        ev = EventService.GetById(Id);
        submitted = false;
    }

    private void Submit() => submitted = true;
}
