@page "/"

<PageTitle>EventEase</PageTitle>

<div class="p-4 mb-4 bg-light rounded-3">
    <h1 class="display-5">Welcome to EventEase</h1>
    <p class="lead">Corporate and social events, all in one place.</p>
    <a class="btn btn-primary btn-lg" href="events">Browse events</a>
</div>

<div class="row row-cols-1 row-cols-md-3 g-3">
    <div class="col">
        <h2 class="h5">Find an event</h2>
        <p class="text-muted">Search upcoming events by name or location and see seats left.</p>
    </div>
    <div class="col">
        <h2 class="h5">Register in seconds</h2>
        <p class="text-muted">Sign in once per session and your details are filled in for you.</p>
        <a href="my-registrations">My registrations</a>
    </div>
    <div class="col">
        <h2 class="h5">Track attendance</h2>
        <p class="text-muted">Check people in at the door and follow attendance live.</p>
        <a href="attendance">Attendance tracker</a>
    </div>
</div>
