@page "/events/{Id:int}/attendance"
@implements IDisposable
@inject EventService EventService
@inject AttendanceService AttendanceService

<PageTitle>Attendance · @(ev?.Name ?? "Event not found") · EventEase</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="attendance">Attendance</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(ev?.Name ?? "Not found")</li>
    </ol>
</nav>

@if (ev is null)
{
    <NotFoundMessage Title="Event not found" Message="@($"No event with ID {Id} exists. It may have been removed.")" />
}
else
{
    var checkedIn = registrations.Count(r => r.CheckedIn);

    <h1>@ev.Name</h1>
    <p class="text-muted">@ev.Date.ToString("D") · @ev.Location · <a href="@($"events/{ev.Id}")">Event details</a></p>

    <p id="event-attendance-summary">
        <strong>@checkedIn</strong> of <strong>@registrations.Count</strong> registered attendees checked in
        (@(registrations.Count == 0 ? "–" : $"{(double)checkedIn / registrations.Count:P0}")) ·
        @registrations.Count / @ev.Capacity seats taken
    </p>

    @if (registrations.Count == 0)
    {
        <div class="alert alert-secondary">Nobody has registered yet.</div>
    }
    else
    {
        <div class="col-md-5 mb-3">
            <label class="form-label small" for="attendee-search">Find attendee</label>
            <input id="attendee-search" class="form-control" placeholder="Name or email"
                   @bind="search" @bind:event="oninput" />
        </div>

        <div class="table-responsive">
            <table class="table align-middle" id="attendee-table">
                <thead>
                    <tr><th>Name</th><th>Email</th><th>Code</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Filtered)
                    {
                        <tr @key="r.Id">
                            <td>@r.FullName</td>
                            <td>@r.Email</td>
                            <td><code>@r.Code</code></td>
                            <td>
                                @if (r.CheckedIn)
                                {
                                    <span class="badge text-bg-success">Checked in @r.CheckedInAt!.Value.ToString("t")</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-light border">Registered</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm @(r.CheckedIn ? "btn-outline-secondary" : "btn-primary")"
                                        @onclick="() => Toggle(r)">
                                    @(r.CheckedIn ? "Undo" : "Check in")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private EventItem? ev;
    private IReadOnlyList<Registration> registrations = [];
    private string search = string.Empty;

    private IEnumerable<Registration> Filtered => string.IsNullOrWhiteSpace(search)
        ? registrations
        : registrations.Where(r => r.FullName.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase)
                                || r.Email.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized() => AttendanceService.Changed += OnAttendanceChanged;

    protected override void OnParametersSet()
    {
        ev = EventService.GetById(Id);
        registrations = ev is null ? [] : AttendanceService.GetForEvent(ev.Id);
    }

    private void Toggle(Registration r) => AttendanceService.SetCheckedIn(r.Id, !r.CheckedIn);

    private void OnAttendanceChanged() => _ = InvokeAsync(() =>
    {
        if (ev is not null) registrations = AttendanceService.GetForEvent(ev.Id);
        StateHasChanged();
    });

    public void Dispose() => AttendanceService.Changed -= OnAttendanceChanged;
}
