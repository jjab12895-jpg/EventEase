@page "/events/{Id:int}"
@implements IDisposable
@inject EventService EventService
@inject AttendanceService Attendance
@inject UserSessionService Session

<PageTitle>@(ev?.Name ?? "Event not found") · EventEase</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="events">Events</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(ev?.Name ?? "Not found")</li>
    </ol>
</nav>

@if (ev is null)
{
    <NotFoundMessage Title="Event not found" Message="@($"No event with ID {Id} exists. It may have been removed.")" />
}
else
{
    var registered = Attendance.CountForEvent(ev.Id);
    var seatsLeft = Math.Max(0, ev.Capacity - registered);
    var isMine = Session.IsSignedIn && Attendance.IsRegistered(ev.Id, Session.CurrentUser!.Email);

    <div class="row g-4">
        <div class="col-md-5">
            @* Two-way binding: valid edits saved in the card update `ev`, and the text on the right re-renders. *@
            <EventCard @bind-Event="ev" ShowActions="false" />
        </div>
        <div class="col-md-7">
            <h1>@ev.Name</h1>
            <p class="lead">@ev.Date.ToString("D") · @ev.Location</p>
            <p>@ev.Description</p>

            <p id="capacity">
                <strong>@registered</strong> of @ev.Capacity seats taken ·
                @if (seatsLeft > 0) { <span class="text-success">@seatsLeft left</span> }
                else { <span class="text-danger">Full</span> }
                @if (isMine) { <span class="badge text-bg-success ms-2" id="registered-badge">You're registered</span> }
            </p>

            @if (ev.IsPast)
            {
                <button class="btn btn-secondary" disabled>Registration closed</button>
            }
            else if (seatsLeft == 0)
            {
                <button class="btn btn-secondary" disabled>Event full</button>
            }
            else
            {
                <a class="btn btn-success" href="@($"events/{ev.Id}/register")">Register for this event</a>
            }
            <a class="btn btn-outline-primary" href="@($"events/{ev.Id}/attendance")">Attendance</a>
            <a class="btn btn-link" href="events">Back to events</a>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private EventItem? ev;
    private int? trackedId;

    protected override void OnInitialized()
    {
        Attendance.Changed += OnStateChanged;
        Session.Changed += OnStateChanged;
    }

    // OnParametersSet (not OnInitialized) so navigating between /events/1 and /events/2 reloads the data.
    protected override void OnParametersSet() => ev = EventService.GetById(Id);

    // Record the visit in the session's "recently viewed" list (needs JS interop, so after render).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ev is not null && trackedId != ev.Id)
        {
            trackedId = ev.Id;
            await Session.TrackViewAsync(ev.Id);
        }
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Attendance.Changed -= OnStateChanged;
        Session.Changed -= OnStateChanged;
    }
}
