@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @* Catches unexpected exceptions in a page so the rest of the app keeps working. *@
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger mt-3">
                        <strong>Something went wrong.</strong> The problem has been logged.
                        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="Recover">Try again</button>
                        <a class="btn btn-sm btn-link" href="events">Back to events</a>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private ErrorBoundary? errorBoundary;

    // Reset the boundary when the user navigates, otherwise the error UI would stick to every page.
    protected override void OnParametersSet() => errorBoundary?.Recover();

    private void Recover() => errorBoundary?.Recover();
}
